{
  "name": "origo",
  "version": "2.11.0-dev",
  "repository": {
    "type": "git",
    "url": "git://github.com/origo-map/origo.git"
  },
  "description": "Framework to build web map apps",
  "keywords": [
    "map",
    "mapping",
    "openlayers",
    "origo"
  ],
  "license": "BSD-2-Clause",
  "scripts": {
    "start": "vite",
    "lint": "eslint -c .eslintrc.json src/index.js src/",
    "lint-fix": "eslint -c .eslintrc.json src/index.js src/ --fix",
    "build": "vite build -c vite.build.config.mjs && node vite.build.plugins.config.mjs"
  },
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "awesomplete": "^1.1.7",
    "cuid": "^3.0.0",
    "downloadjs": "^1.4.7",
    "drag-drop-touch": "^1.3.1",
    "elm-pep": "^1.0.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "ol": "^10.6.0",
    "ol-mapbox-style": "12.5.0",
    "pepjs": "^0.5.3",
    "proj4": "^2.15.0"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "run-sequence": "^2.2.1",
    "sass-embedded": "^1.86.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
